      {
        "OTIO_SCHEMA": "Marker.2",
        "metadata": {
          "Resolve_OTIO": {
            "Keywords": [],
            "Note": "[stern British newsreader, crisp and measured] This is The 8-Bit Guy. For years, he has mended old computers on YouTube. [grave] Then he vanished... for three months. [flat, deadpan] He came back with THIS.  [picture: Murray's announcement video]"
          }
        },
        "name": "Moo 1",
        "color": "BLUE",
        "marked_range": {
          "OTIO_SCHEMA": "TimeRange.1",
