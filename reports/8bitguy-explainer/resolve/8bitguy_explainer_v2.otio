      {
        "OTIO_SCHEMA": "Marker.2",
        "metadata": {
          "Resolve_OTIO": {
            "Keywords": [],
            "Note": "[stern] A fifty-minute superhero film. Made with A.I. [arch, one eyebrow raised] It is called... The Tech Support Guy. [dry, deadpan] The hero does tech support.  [picture: The film's opening]"
          }
        },
        "name": "Moo 2",
        "color": "BLUE",
        "marked_range": {
