            "rate": 30.0,
            "value": 65.0
          }
        }
      },
      {
        "OTIO_SCHEMA": "Marker.2",
        "metadata": {
          "Resolve_OTIO": {
            "Keywords": [],
            "Note": "Murray: \"...quite unusual for my channel.\""
          }
        },
        "name": "Bite",
        "color": "YELLOW",
        "marked_range": {
          "OTIO_SCHEMA": "TimeRange.1",
