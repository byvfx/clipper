      {
        "OTIO_SCHEMA": "Marker.2",
        "metadata": {
          "Resolve_OTIO": {
            "Keywords": [],
            "Note": "[crisp] He booked a cinema for the premiere. [dry, a beat later] He did not make it.  [picture: Murray's premiere post]"
