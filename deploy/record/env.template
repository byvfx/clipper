# Copied to deploy/record/env.local on first deploy (gitignored), then to the NAS as .env.
# Discord webhook for recorder alerts (Server Settings > Integrations > Webhooks). Optional:
# alerts always go to `docker logs clipper-record-record-1`.
CLIPPER_ALERT_WEBHOOK=
# Or set [record] alert_channel_id in clipper.toml and give the bot token here:
DISCORD_BOT_TOKEN=
# Owner of files written under CLIPPER_DATA (the NAS user Brandon is 1000:10).
PUID=1000
PGID=10
CLIPPER_DATA=/volume1/docker/clipper
