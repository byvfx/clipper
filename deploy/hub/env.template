# Copied to deploy/hub/env.local on first deploy (gitignored), then to the NAS as .env
# (chmod 600). Keys the containers need; the rest are files under $CLIPPER_DATA/secrets.
ANTHROPIC_API_KEY=
KITSU_TOKEN=
# Modal (transcription): the token in ~/.modal.toml on a machine that ran `modal token new`
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Discord webhook for alerts (the recorder's, deploy/record/env.local); optional
CLIPPER_ALERT_WEBHOOK=
# Optional, if not in secrets/: DISCORD_BOT_TOKEN, ELEVENLABS_API_KEY, BRAVE_API_KEY,
# OPENAI_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, HF_TOKEN, ANTHROPIC_ADMIN_KEY
# A Tailscale auth key signs the NAS in on first start; empty = a sign-in link in
# `docker compose logs tailscale`
TS_AUTHKEY=
TS_HOSTNAME=clipper
# Owner of files written under CLIPPER_DATA (the NAS user Brandon is 1000:10), and the
# group of /dev/dri/renderD128 (`stat -c %g /dev/dri/renderD128` on the NAS)
PUID=1000
PGID=10
RENDER_GID=105
CLIPPER_DATA=/volume1/docker/clipper
