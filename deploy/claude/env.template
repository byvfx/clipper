# Copied to deploy/claude/env.local on first deploy (gitignored), then to the NAS as .env
# (chmod 600). The keys clipper's stages need, as in deploy/hub/env.local (copy them from
# there); the rest are files under $CLIPPER_DATA/secrets. deploy.sh hands ANTHROPIC_API_KEY
# to clipper as a file, never as a variable: Remote Control refuses to start where it is set.
ANTHROPIC_API_KEY=
KITSU_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
CLIPPER_ALERT_WEBHOOK=
# Optional, if not in secrets/: ELEVENLABS_API_KEY, BRAVE_API_KEY, OPENAI_API_KEY,
# GEMINI_API_KEY, OPENROUTER_API_KEY, HF_TOKEN
# GitHub: a fine-grained token for this repo only (Contents and Pull requests: read and
# write), so Claude can push branches and open PRs from the NAS. Empty = read-only clone of a
# public repo; a private one won't clone.
GH_TOKEN=
# The repo to clone and who commits there; empty = this checkout's origin and git user
CLIPPER_REPO=
GIT_USER_NAME=
GIT_USER_EMAIL=
# Owner of files written under CLIPPER_DATA and CLAUDE_DIR (as in deploy/hub/env.local), and
# the group of /dev/dri/renderD128
PUID=1000
PGID=10
RENDER_GID=105
CLIPPER_DATA=/volume1/docker/clipper
# The clone (repo/) and Claude Code's home (home/: its sign-in, settings and memory)
CLAUDE_DIR=/volume1/docker/clipper-claude
# The session's name in the app, and its starting permission mode (default asks before each
# command; acceptEdits or auto, or change it per session in the app)
CLAUDE_SESSION_NAME=clipper on the NAS
CLAUDE_PERMISSION_MODE=default
# The nightly checkup (#185, checkup.sh): HH:MM in TZ, after [notify] quiet_hours end; "" = off
CHECKUP_AT=08:30
# After the checkup on these days (audit.sh; needs CHECKUP_AT): the weekly digest on AUDIT_WEEKDAY
# (1 = Monday ... 7 = Sunday), the deep audit on AUDIT_MONTHDAY; "" = off
AUDIT_WEEKDAY=7
AUDIT_MONTHDAY=1
